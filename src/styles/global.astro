<style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Google+Sans+Code:ital,wght,MONO@0,300..800,1;1,300..800,1&display=swap');
    html,
    body {
        margin: 0;
        min-height: 100%;
        color: #fff;
        font-family: "Google Sans Code", monospace;
    }

    body {
        min-height: 100vh;
    }

    .page {
        position: relative;
        isolation: isolate;
        min-height: 100vh;
        overflow: hidden;
        width: 100%;
        display: grid;
        place-items: center;
    }

    .page::before {
        content: "";
        position: absolute;
        inset: -20px;
        z-index: -2;

        background: url("/background2.jpg") center / cover no-repeat;
        filter: blur(32px);
        transform: scale(1.05);
    }

    .page::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: rgba(0, 0, 0, 0.8);
    }


    #center-card {
        width: min(70%, 800px);
        padding: 5rem;
        background: rgba(0.05, 0.05, 0.05, 0.5);
        color: #fff;
        border-radius: 8px;
        backdrop-filter: blur(16px);
        /* text-align: center; */
        box-sizing: border-box;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 3rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.9);
    }

    #name-text {
        font-size: 20pt;
        font-weight: 300;
        text-align: right;
    }

    #sub-text {
        font-size: 10pt;
        font-weight: 300;
        text-align: right;
    }
    
    #project-links {
        font-size: 10pt;
        font-weight: 300;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-start;
    }

    #site-links {
        font-size: 10pt;
        font-weight: 300;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-start;
    }

    a {
        position: relative;
        color: #cccccc;
        text-decoration: none;
    }

    a::after {
        content: "";
        position: absolute;
        left: 0;box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        bottom: 0px;
        width: 100%;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.25s ease;
    }

    a:hover::after,
        a:focus-visible::after {
        transform: scaleX(1);
        transform-origin: left;
    }
</style>
